# 发布签名配置模板
# 使用方法：
#   1) 生成密钥库（有效期 10000 天，按需调整）：
#      keytool -genkeypair -v -keystore release.jks -alias ind_edge \
#              -keyalg RSA -keysize 2048 -validity 10000
#   2) 复制本文件为 keystore.properties 并填入实际值；
#   3) ./gradlew assembleRelease 即产出已签名 APK。
# 注意：keystore.properties 与 *.jks 均已在 .gitignore 中，不会入库。

storeFile=release.jks
storePassword=CHANGE_ME
keyAlias=ind_edge
keyPassword=CHANGE_ME
